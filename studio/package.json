{
  "name": "creative-automation-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "build:pages": "npm run build && node scripts/pages-build.mjs",
    "test:rules": "node --test tests/firebase/*.test.js"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.60.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
